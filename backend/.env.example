# Copy this file to .env and fill in real values. Never commit .env.

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=log_pipeline
MYSQL_USER=log_pipeline
MYSQL_PASSWORD=changeme_in_env
MYSQL_ROOT_PASSWORD=changeme_in_env

# --- Redis / BullMQ ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- API / WebSocket server ---
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Ingestion simulator ---
LOG_SOURCE_FILE=../data/Linux_2k.log
INGEST_MIN_DELAY_MS=100
INGEST_MAX_DELAY_MS=400

# --- Worker batching ---
BATCH_SIZE=5
BATCH_WAIT_MS=2000
MAX_RETRIES=3

# --- LLM provider (not wired in yet — plumbing stage uses a stub) ---
LLM_API_KEY=
LLM_MODEL=

# --- Anomaly baseline ---
BASELINE_WINDOW_MS=60000
ANOMALY_ZSCORE_THRESHOLD=2.5
